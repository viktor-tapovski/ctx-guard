#!/usr/bin/env python3
"""
ctx-guard-stats: summarizes the stats.jsonl event log so you can verify
ctx-guard is actually saving tokens, instead of taking it on faith.

Two kinds of numbers are reported, and they are NOT conflated:

  MEASURED  -- real before/after byte counts from ctx-guard-run (the command
              wrapper). We run the real command exactly once and know the
              full log size vs. what was actually returned, so this is a
              hard number, not an estimate.

  OBSERVED  -- rewrite counts from pre_bash_rewrite.py (e.g. "git status"
              rewritten to "--porcelain") and tool-output sizes from
              context_monitor.py. We do NOT fabricate a "tokens saved" figure
              for these: since the unbounded/original command is never run,
              there is no ground truth to diff against. Only counts and
              observed sizes are shown.

Token estimates use the same bytes/4 heuristic ctx-guard uses elsewhere.

--gains is a separate view over MEASURED events only, grouped by the program
name ctx-guard-run logs with each event (never its arguments or paths).
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import time
from datetime import datetime, timedelta, timezone
from collections import Counter, defaultdict

def ctx_guard_version() -> str:
    """Read the shared version module. realpath, not abspath: install.sh
    symlinks this script into ~/.local/bin, and the module lives next to the
    real copy under ~/.ctx-guard/hooks/lib."""
    lib = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "hooks", "lib")
    sys.path.insert(0, lib)
    try:
        from version import __version__
        return __version__
    except ImportError:
        return "unknown"


def _default_stats_file() -> str:
    # Same rule as ctx-guard-run and hooks/lib: STATS_FILE > STATE_DIR > XDG default.
    if os.environ.get("CTX_GUARD_STATS_FILE"):
        return os.environ["CTX_GUARD_STATS_FILE"]
    if os.environ.get("CTX_GUARD_STATE_DIR"):
        return os.path.join(os.environ["CTX_GUARD_STATE_DIR"], "stats.jsonl")
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(
        os.path.expanduser("~"), ".local", "state"
    )
    path = os.path.join(base, "ctx-guard", "stats.jsonl")
    legacy = os.path.join(
        os.environ.get("CTX_GUARD_RUNTIME_ROOT") or f"/tmp/ctx-guard-{os.getuid()}",
        "state",
        "stats.jsonl",
    )
    # Writers fall back to the legacy path when the persistent dir is unwritable.
    return legacy if not os.path.exists(path) and os.path.exists(legacy) else path


DEFAULT_STATS_FILE = _default_stats_file()


def load_events(path: str, since_ts: float | None) -> list[dict]:
    events = []
    if not os.path.isfile(path):
        return events
    with open(path, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                ev = json.loads(line)
            except json.JSONDecodeError:
                continue
            if since_ts is not None and ev.get("ts", 0) < since_ts:
                continue
            events.append(ev)
    return events


def spooled_paths(dest: str) -> list[str]:
    """Drain sandbox spools (see hooks/lib spool_files) into `dest`, and return
    any that could not be drained -- e.g. when this runs inside the sandbox
    itself -- so they are still read instead of silently missing."""
    try:
        from ctx_guard_common import drain_spools, spool_files
    except ImportError:
        return []
    drain_spools(dest)
    return spool_files(dest)


def fmt_bytes(n: float) -> str:
    for unit in ("B", "KB", "MB", "GB"):
        if abs(n) < 1024:
            return f"{n:.0f}{unit}" if unit == "B" else f"{n:.1f}{unit}"
        n /= 1024
    return f"{n:.1f}TB"


def fmt_tokens(n: float) -> str:
    if n >= 1_000_000:
        return f"{n / 1_000_000:.2f}M"
    if n >= 1_000:
        return f"{n / 1_000:.1f}K"
    return f"{n:.0f}"


BREAKDOWN_TITLES = {"daily": ("Daily", "Date"), "weekly": ("Weekly", "Week"),
                    "monthly": ("Monthly", "Month")}
BAR_WIDTH = 24
LABEL_WIDTH = 20
EIGHTHS = "▏▎▍▌▋▊▉"  # 1/8 .. 7/8 of a cell; a full cell is █


def unicode_ok() -> bool:
    """Whether stdout can carry the block glyphs. Under LC_ALL=C and on some
    minimal images it cannot, and an unguarded print would traceback."""
    try:
        "█░·".encode(sys.stdout.encoding or "ascii")
    except (LookupError, UnicodeEncodeError):
        return False
    return True


def bars_enabled() -> bool:
    """Bars are decoration: on for a terminal, off for pipes, files and tests."""
    mode = os.environ.get("CTX_GUARD_BARS", "auto")
    if mode == "always":
        return True
    if mode == "never":
        return False
    return sys.stdout.isatty()


def render_bar(value: float, total: float, width: int = BAR_WIDTH) -> str:
    """Return a '|bar|' string filled to value/total, to the nearest eighth of
    a cell -- at width 24 whole cells would quantize the gauge to 4% steps."""
    frac = 0.0 if total <= 0 else max(0.0, min(1.0, value / total))
    if not unicode_ok():
        filled = round(width * frac)
        return f"|{'#' * filled}{'-' * (width - filled)}|"

    full, rem = divmod(round(width * 8 * frac), 8)
    bar = "█" * full + (EIGHTHS[rem - 1] if rem else "")
    return f"|{bar}{'░' * (width - len(bar))}|"


def print_bar(label: str, value: float, total: float, display: str,
              indent: str = "    ") -> None:
    """Print '<label> <bar> <display>', dropping the bar when bars are off."""
    desc = f"{indent}{label:{LABEL_WIDTH}s}"
    if total <= 0 or not bars_enabled():
        print(f"{desc} {display}")
        return
    print(f"{desc} {render_bar(value, total)} {display}")


def print_gauge(summary: dict) -> None:
    """The default view: one line, the headline savings and nothing else."""
    measured = summary["measured"]
    observed = summary["observed"]
    bars = bars_enabled()
    sep = "  ·  " if bars and unicode_ok() else "  -  "

    if not measured["commands_wrapped"] and not measured["saved_bytes"]:
        # Nothing was wrapped, so no before/after pair exists and there is no
        # honest ratio to print. Report the observed volume instead of a bare
        # event count -- same MEASURED/OBSERVED split the full report makes.
        parts = []
        rewrites = observed["total_rewrites"]
        if rewrites:
            parts.append(f"{rewrites} rewrite{'' if rewrites == 1 else 's'}")
        if observed["total_tool_output_bytes"]:
            parts.append(f"{fmt_bytes(observed['total_tool_output_bytes'])} tool output")
        if summary["pkg_blocked_count"] or summary["pkg_warned_count"]:
            parts.append(f"pkg-guard: {summary['pkg_blocked_count']} blocked, "
                         f"{summary['pkg_warned_count']} warned")
        if summary["estimated"]["rewrites"]:
            parts.append(f"est. ~{fmt_tokens(summary['estimated']['saved_tokens_est'])} tokens")
        if not parts:
            n = summary["events"]
            parts.append(f"{n} event{'' if n == 1 else 's'}")
        print(f"ctx-guard  no measured savings yet{sep}{sep.join(parts)} observed"
              f"  --  try --verbose")
        return

    pct = measured["compression_ratio_pct"]
    if measured["commands_wrapped"]:
        bar = f"{render_bar(pct, 100)} " if bars else ""
        head = f"{pct}%" if bars else f"{pct}% reduction"
    else:
        bar, head = "", "rewrites only"
    tail = ""
    for agent, info in sorted(summary["by_agent"].items()):
        if info["saved_bytes"]:
            tail += f"{sep}{agent} {fmt_bytes(info['saved_bytes'])}"
    if summary["pkg_blocked_count"] or summary["pkg_warned_count"]:
        tail += (f"{sep}pkg-guard: {summary['pkg_blocked_count']} blocked, "
                 f"{summary['pkg_warned_count']} warned")
    if summary["estimated"]["rewrites"]:
        tail += f"{sep}+ est. ~{fmt_tokens(summary['estimated']['saved_tokens_est'])} from rewrites"
    print(f"ctx-guard  {bar}{head}"
          f"{sep}{fmt_bytes(measured['saved_bytes'])} saved"
          f"{sep}~{fmt_tokens(measured['saved_tokens_est'])} tokens"
          f"{tail}")


def bucket_keys(ts: float) -> dict[str, tuple[str, str]]:
    """(sort key, label) per granularity for an event timestamp, in UTC."""
    d = datetime.fromtimestamp(ts, timezone.utc).date()
    mon = d - timedelta(days=d.weekday())
    sun = mon + timedelta(days=6)
    return {
        "daily": (d.isoformat(), d.isoformat()),
        "weekly": (mon.isoformat(), f"{mon:%m-%d} → {sun:%m-%d}"),
        "monthly": (f"{d:%Y-%m}", f"{d:%Y-%m}"),
    }


def build_breakdown(events: list[dict]) -> dict[str, list[dict]]:
    groups: dict[str, dict] = {g: {} for g in BREAKDOWN_TITLES}
    for e in events:
        kind = e.get("kind")
        if kind not in ("ctx_guard_run", "rewrite"):
            continue
        orig = ret = 0
        if kind == "ctx_guard_run":
            orig, ret = e.get("original_bytes", 0), e.get("returned_bytes", 0)
            saved = orig - ret
        else:
            saved = e.get("saved_bytes", 0)
        for gran, (key, label) in bucket_keys(e.get("ts", 0)).items():
            row = groups[gran].setdefault(key, {
                "label": label, "commands": 0, "original_bytes": 0,
                "returned_bytes": 0, "saved_bytes": 0})
            row["commands"] += kind == "ctx_guard_run"
            row["original_bytes"] += orig
            row["returned_bytes"] += ret
            row["saved_bytes"] += saved
    out = {}
    for gran, rows in groups.items():
        out[gran] = [rows[k] for k in sorted(rows)]
        for r in out[gran]:
            r["saved_pct"] = (round(100 * r["saved_bytes"] / r["original_bytes"], 1)
                              if r["original_bytes"] else 0.0)
    return out


def breakdown_totals(rows: list[dict]) -> dict:
    t = {k: sum(r[k] for r in rows)
         for k in ("commands", "original_bytes", "returned_bytes", "saved_bytes")}
    t["saved_pct"] = (round(100 * t["saved_bytes"] / t["original_bytes"], 1)
                      if t["original_bytes"] else 0.0)
    return t


def print_breakdown(title: str, header: str, rows: list[dict]) -> None:
    color = bars_enabled()
    lw = max([len(header), 5] + [len(r["label"]) for r in rows])
    widths = (5, 12, 12, 12, 6)
    cols = ("Cmds", "Input (tok)", "Output (tok)", "Saved (tok)", "Save%")

    def line(label: str, r: dict) -> str:
        cells = (str(r["commands"]), fmt_tokens(r["original_bytes"] / 4),
                 fmt_tokens(r["returned_bytes"] / 4), fmt_tokens(r["saved_bytes"] / 4))
        pct = f"{r['saved_pct']:.1f}%"
        pct_cell = f"{pct:>{widths[4]}}"
        if color:
            pct_cell = f"\033[32m{pct_cell}\033[0m"
        return (f"{label:{lw}s}  "
                + "  ".join(f"{c:>{w}}" for c, w in zip(cells, widths)) + f"  {pct_cell}")

    head = (f"{header:{lw}s}  "
            + "  ".join(f"{c:>{w}}" for c, w in zip(cols, widths)))
    rule = "─" * len(head) if unicode_ok() else "-" * len(head)
    print(f"{title} Breakdown:")
    print(rule)
    print(head)
    print(rule)
    for r in rows:
        print(line(r["label"], r))
    print(rule)
    print(line("TOTAL", breakdown_totals(rows)))
    print()


def fmt_ms(ms: float) -> str:
    if ms < 1000:
        return f"{ms:.0f}ms"
    if ms < 60_000:
        return f"{ms / 1000:.1f}s"
    minutes, seconds = divmod(round(ms / 1000), 60)
    return f"{minutes}m{seconds:02d}s"


def estimated_summary(events: list[dict]) -> dict:
    """ESTIMATED savings: rewrites whose unbounded form never ran, sized from
    the returned bytes and an assumed per-rule ratio. Never mixed into MEASURED."""
    est = [e for e in events if e.get("kind") == "rewrite_estimate"]
    by_rule = defaultdict(lambda: {"count": 0, "saved_tokens": 0})
    for e in est:
        r = by_rule[e.get("rule", "unknown")]
        r["count"] += 1
        r["saved_tokens"] += round(e.get("est_saved_bytes", 0) / 4)
    saved = sum(e.get("est_saved_bytes", 0) for e in est)
    return {"rewrites": len(est), "saved_bytes": saved,
            "saved_tokens_est": round(saved / 4), "by_rule": dict(by_rule)}


def measured_runs(events: list[dict]) -> list[dict]:
    """ctx-guard-run events plus read-only rewrites that measured both sides
    (named by the rule's program, e.g. git-status -> git)."""
    runs = [e for e in events if e.get("kind") == "ctx_guard_run"]
    for e in events:
        if e.get("kind") == "rewrite" and "original_bytes" in e:
            runs.append({**e, "command": e.get("rule", "unknown").split("-")[0]})
    return runs


def gains_summary(events: list[dict], top: int) -> dict:
    """The --gains view: MEASURED events grouped by program name, plus the
    ESTIMATED rewrite total kept separate. Events from before `command` was
    logged group under (unknown)."""
    runs = measured_runs(events)
    total_orig = sum(e.get("original_bytes", 0) for e in runs)
    total_returned = sum(e.get("returned_bytes", 0) for e in runs)
    saved_bytes = max(0, total_orig - total_returned)
    exec_ms = sum(e.get("duration_ms", 0) for e in runs)

    groups = defaultdict(list)
    for e in runs:
        groups[e.get("command") or "(unknown)"].append(e)
    rows = []
    for name, evs in groups.items():
        orig = sum(e.get("original_bytes", 0) for e in evs)
        ret = sum(e.get("returned_bytes", 0) for e in evs)
        pcts = [100 * max(0, e.get("original_bytes", 0) - e.get("returned_bytes", 0))
                / e["original_bytes"] if e.get("original_bytes") else 0.0 for e in evs]
        rows.append({
            "command": name,
            "count": len(evs),
            "saved_tokens": round(max(0, orig - ret) / 4),
            "avg_saved_pct": round(sum(pcts) / len(pcts), 1),
            "avg_ms": round(sum(e.get("duration_ms", 0) for e in evs) / len(evs)),
            "total_ms": sum(e.get("duration_ms", 0) for e in evs),
        })
    rows.sort(key=lambda r: (-r["saved_tokens"], r["command"]))

    return {
        "total_commands": len(runs),
        "input_tokens": round(total_orig / 4),
        "output_tokens": round(total_returned / 4),
        "tokens_saved": round(saved_bytes / 4),
        "saved_pct": round(100 * saved_bytes / total_orig, 1) if total_orig else 0.0,
        "exec_ms_total": exec_ms,
        "exec_ms_avg": round(exec_ms / len(runs)) if runs else 0,
        "by_command": rows[:top],
        # Unmeasured rewrites only: measured ones and wraps are rows above.
        "rewrites": sum(1 for e in events if e.get("kind") == "rewrite"
                        and "original_bytes" not in e
                        and e.get("rule") not in ("compound-wrap", "runner-wrap")),
        "blocked": sum(1 for e in events if e.get("kind") == "blocked"),
        "estimated": estimated_summary(events),
    }


def print_estimate_line(est: dict, dot: str) -> None:
    if est["rewrites"]:
        print(paint(f"est. saved by rewrites: ~{fmt_tokens(est['saved_tokens_est'])} tokens "
                    f"{dot} {est['rewrites']} rewrites (assumed per-rule ratios, not measured)", "2"))


def color_enabled() -> bool:
    return bars_enabled() and "NO_COLOR" not in os.environ


def paint(text: str, code: str) -> str:
    return f"\033[{code}m{text}\033[0m" if color_enabled() else text


def print_gains(g: dict) -> None:
    uni = unicode_ok()
    dot = "·" if uni else "-"
    if not g["total_commands"]:
        print("No measured commands yet")
        print("Run commands through ctx-guard-run, or widen --since.")
        print_estimate_line(g["estimated"], dot)
        return

    heavy, light = ("═", "─") if uni else ("=", "-")
    bars = bars_enabled()
    title = "ctx-guard Token Savings"
    print(title)
    print(heavy * len(title))
    meter = f"{render_bar(g['saved_pct'], 100)} " if bars else ""
    fields = [
        ("Total commands", str(g["total_commands"])),
        ("Input tokens", fmt_tokens(g["input_tokens"])),
        ("Output tokens", fmt_tokens(g["output_tokens"])),
        ("Tokens saved", f"{fmt_tokens(g['tokens_saved'])} ({g['saved_pct']}%)"),
        ("Total exec time", f"{fmt_ms(g['exec_ms_total'])} (avg {fmt_ms(g['exec_ms_avg'])})"),
        ("Efficiency meter", f"{meter}{g['saved_pct']}%"),
    ]
    for label, value in fields:
        print(f"{label + ':':18s}{value}")
    print()

    heading = "By Command"
    print(heading)
    print(light * len(heading))
    rows = g["by_command"]
    name_w = max([len("Command")] + [len(r["command"]) for r in rows])
    header = f"{'#':>3}  {'Command':{name_w}s}  {'Count':>5}  {'Saved':>7}  {'Avg%':>6}  {'Time':>7}"
    if bars:
        header += "  Impact"
    print(header)
    print(light * (len(header) + (4 if bars else 0)))
    top_saved = max((r["saved_tokens"] for r in rows), default=0)
    for i, r in enumerate(rows, 1):
        pct = r["avg_saved_pct"]
        code = "32" if pct >= 90 else "33" if pct >= 50 else "31"
        pct_cell = paint(f"{pct:>5.1f}%", code)
        line = (f"{i:>3}  {r['command']:{name_w}s}  {r['count']:>5}  "
                f"{fmt_tokens(r['saved_tokens']):>7}  {pct_cell}  {fmt_ms(r['total_ms']):>7}")
        if bars:
            line += f"  {render_bar(r['saved_tokens'], top_saved, 8)}"
        print(line)
    print()
    print(paint(f"rewrites: {g['rewrites']} {dot} blocked: {g['blocked']} (not counted above)", "2"))
    print_estimate_line(g["estimated"], dot)


def main() -> None:
    parser = argparse.ArgumentParser(description="Summarize ctx-guard stats.jsonl")
    parser.add_argument("--version", action="version",
                        version=f"ctx-guard {ctx_guard_version()}")
    parser.add_argument("--stats-file", default=DEFAULT_STATS_FILE)
    parser.add_argument("--since", default=None,
                         help="e.g. 1d, 7d, 24h -- only include events at/after this age")
    parser.add_argument("--json", action="store_true", help="print machine-readable JSON summary")
    parser.add_argument("-v", "--verbose", action="store_true",
                        help="print the full MEASURED/OBSERVED report instead of the one-line gauge")
    parser.add_argument("--breakdown", nargs="?", const="all", default=None,
                        choices=["daily", "weekly", "monthly", "all"],
                        help="per-day/week/month table of commands, tokens and savings")
    parser.add_argument("--gains", action="store_true",
                        help="show measured token savings per command instead of the default report")
    parser.add_argument("-n", "--top", type=int, default=10, metavar="N",
                        help="rows in the --gains By Command table (default 10)")
    parser.add_argument("--reset", action="store_true", help="delete the stats file and exit")
    args = parser.parse_args()
    if args.gains and (args.verbose or args.breakdown):
        parser.error("--gains cannot be combined with --verbose or --breakdown")
    if args.top < 1:
        parser.error("--top must be at least 1")

    if args.reset:
        if os.path.isfile(args.stats_file):
            os.remove(args.stats_file)
            print(f"Deleted {args.stats_file}")
        else:
            print("No stats file to delete.")
        return

    since_ts = None
    if args.since:
        unit = args.since[-1]
        try:
            amount = float(args.since[:-1])
        except ValueError:
            print(f"Invalid --since value: {args.since}", file=sys.stderr)
            sys.exit(1)
        seconds = {"h": 3600, "d": 86400, "w": 604800}.get(unit)
        if seconds is None:
            print(f"Invalid --since unit (use h/d/w): {args.since}", file=sys.stderr)
            sys.exit(1)
        since_ts = time.time() - amount * seconds

    leftover = []
    if args.stats_file == DEFAULT_STATS_FILE:
        ctx_guard_version()  # puts hooks/lib on sys.path
        leftover = spooled_paths(args.stats_file)  # drains first, so this run sees it
    events = load_events(args.stats_file, since_ts)
    for spool in leftover:
        events += load_events(spool, since_ts)

    if args.gains:
        gains = gains_summary(events, args.top)
        if args.json:
            for row in gains["by_command"]:
                del row["total_ms"]
            print(json.dumps({"gains": gains}, indent=2))
        else:
            print_gains(gains)
        return

    if not events:
        if args.json:
            print(json.dumps({"events": 0}))
        else:
            print(f"No ctx-guard stats recorded yet in {args.stats_file}.")
            print("Stats accumulate as ctx-guard rewrites commands or wraps verbose output.")
        return

    if args.breakdown:
        grans = list(BREAKDOWN_TITLES) if args.breakdown == "all" else [args.breakdown]
        data = build_breakdown(events)
        if args.json:
            out = {g: data[g] for g in grans}
            out["totals"] = breakdown_totals(data[grans[0]])
            print(json.dumps(out, indent=2))
            return
        for g in grans:
            print_breakdown(*BREAKDOWN_TITLES[g], data[g])
        return

    by_agent = defaultdict(list)
    for ev in events:
        by_agent[ev.get("agent", "unknown")].append(ev)

    # --- MEASURED: ctx-guard-run before/after ---
    run_events = [e for e in events if e.get("kind") == "ctx_guard_run"]
    compressed = [e for e in run_events if e.get("compressed")]
    total_orig = sum(e.get("original_bytes", 0) for e in run_events)
    total_returned = sum(e.get("returned_bytes", 0) for e in run_events)
    run_saved = max(0, total_orig - total_returned)

    # --- MEASURED: read-only rewrites that recorded before/after bytes ---
    rewrite_events = [e for e in events if e.get("kind") == "rewrite"]
    rewrite_saved = sum(e.get("saved_bytes", 0) for e in rewrite_events)
    saved_bytes = run_saved + rewrite_saved
    saved_tokens = saved_bytes / 4

    saved_by_agent = defaultdict(int)
    for e in run_events:
        saved_by_agent[e.get("agent", "unknown")] += max(
            0, e.get("original_bytes", 0) - e.get("returned_bytes", 0))
    for e in rewrite_events:
        saved_by_agent[e.get("agent", "unknown")] += e.get("saved_bytes", 0)
    rewrite_by_rule = Counter(e.get("rule", "unknown") for e in rewrite_events)

    # --- OBSERVED: raw tool output volume delivered to the model ---
    tool_events = [e for e in events if e.get("kind") == "tool_output"]
    tool_bytes_by_tool = defaultdict(int)
    for e in tool_events:
        tool_bytes_by_tool[e.get("tool_name", "unknown")] += e.get("result_bytes", 0)
    total_tool_bytes = sum(tool_bytes_by_tool.values())

    # --- OBSERVED: pkg-install security checks ---
    pkg_blocked = [e for e in events if e.get("kind") == "pkg_blocked"]
    pkg_warned = [e for e in events if e.get("kind") == "pkg_warned"]

    summary = {
        "events": len(events),
        "agents": {a: len(evs) for a, evs in by_agent.items()},
        "measured": {
            "commands_wrapped": len(run_events),
            "commands_compressed": len(compressed),
            "original_bytes": total_orig,
            "returned_bytes": total_returned,
            "saved_bytes": saved_bytes,
            "saved_tokens_est": round(saved_tokens),
            "compression_ratio_pct": round(100 * run_saved / total_orig, 1) if total_orig else 0.0,
        },
        "by_agent": {
            a: {"saved_bytes": b, "saved_tokens_est": round(b / 4)}
            for a, b in saved_by_agent.items()
        },
        "observed": {
            "rewrites_by_rule": dict(rewrite_by_rule),
            "total_rewrites": len(rewrite_events),
            "tool_output_bytes_by_tool": dict(tool_bytes_by_tool),
            "total_tool_output_bytes": total_tool_bytes,
        },
        "estimated": estimated_summary(events),
        "pkg_blocked_count": len(pkg_blocked),
        "pkg_warned_count": len(pkg_warned),
    }

    if args.json:
        print(json.dumps(summary, indent=2))
        return

    if not args.verbose:
        print_gauge(summary)
        return

    print(f"ctx-guard stats  ({len(events)} events, file: {args.stats_file})")
    print("By agent: " + ", ".join(f"{a}={len(evs)}" for a, evs in by_agent.items()))
    print()
    print("== MEASURED (real before/after bytes from ctx-guard-run) ==")
    print(f"  commands wrapped:      {len(run_events)}  ({len(compressed)} actually compressed)")
    print(f"  original output:       {fmt_bytes(total_orig)}")
    print(f"  returned to model:     {fmt_bytes(total_returned)}")
    print(f"  saved:                 {fmt_bytes(saved_bytes)}  "
          f"({summary['measured']['compression_ratio_pct']}% reduction)")
    print(f"  estimated tokens saved: ~{fmt_tokens(saved_tokens)}  (bytes/4 heuristic)")
    if bars_enabled():
        pct = summary["measured"]["compression_ratio_pct"]
        print_bar("reduction", pct, 100, f"{pct}%", indent="  ")
    print()
    print("== OBSERVED (no ground-truth baseline, counts/sizes only -- not 'tokens saved') ==")
    print(f"  command rewrites applied: {len(rewrite_events)}")
    top_rules = rewrite_by_rule.most_common(10)
    max_rule = max((c for _, c in top_rules), default=0)
    for rule, count in top_rules:
        print_bar(rule, count, max_rule, str(count))
    print(f"  total tool output delivered: {fmt_bytes(total_tool_bytes)} "
          f"(~{fmt_tokens(total_tool_bytes / 4)} tokens)")
    top_tools = sorted(tool_bytes_by_tool.items(), key=lambda kv: -kv[1])[:10]
    max_tool = max((b for _, b in top_tools), default=0)
    for tool, nbytes in top_tools:
        print_bar(tool, nbytes, max_tool, fmt_bytes(nbytes))
    print(f"  packages blocked (nonexistent/hallucinated): {summary['pkg_blocked_count']}")
    print(f"  packages warned (age/typosquat/unpinned/unverifiable/bypass-flag): "
          f"{summary['pkg_warned_count']}")
    est = summary["estimated"]
    print()
    print("== ESTIMATED (rewrites: returned bytes + assumed per-rule ratio -- not measured) ==")
    print(f"  rewrites estimated:     {est['rewrites']}")
    print(f"  estimated tokens saved: ~{fmt_tokens(est['saved_tokens_est'])}")
    rules = sorted(est["by_rule"].items(), key=lambda kv: -kv[1]["saved_tokens"])[:10]
    max_est = max((r["saved_tokens"] for _, r in rules), default=0)
    for rule, r in rules:
        print_bar(rule, r["saved_tokens"], max_est, f"~{fmt_tokens(r['saved_tokens'])} ({r['count']})")


if __name__ == "__main__":
    main()
