#!/usr/bin/env bash
# ctx-guard-run: executes a command script, caps output that reaches the
# agent, and archives the full output to disk so nothing is lost. Also logs
# a real, measured before/after byte count to the shared stats file so
# `ctx-guard-stats` can report actual (not estimated) token savings.
#
# Usage: ctx-guard-run <script-file> [agent]
# Env:   CTX_GUARD_MAX_LINES          (default 150)  max lines returned to context
#        CTX_GUARD_LOG_DIR            (default /tmp/ctx-guard-<uid>/logs; falls
#                                     back to $TMPDIR when that is not writable)
#        CTX_GUARD_LOG_RETENTION_DAYS (default 7)     delete archived logs older than this
#        CTX_GUARD_STATE_DIR          (default /tmp/ctx-guard-<uid>/state) session markers; also stats.jsonl
#                                     if set explicitly
#        CTX_GUARD_STATS_FILE         (default ${XDG_STATE_HOME:-~/.local/state}/ctx-guard/stats.jsonl;
#                                     falls back to /tmp/ctx-guard-<uid>/state/stats.jsonl)
#        CTX_GUARD_AGENT              (default "unknown") tag written into stats events

set -uo pipefail

MAX_LINES="${CTX_GUARD_MAX_LINES:-150}"
DEFAULT_ROOT="/tmp/ctx-guard-$(id -u)"
LOG_DIR="${CTX_GUARD_LOG_DIR:-$DEFAULT_ROOT/logs}"
RETENTION_DAYS="${CTX_GUARD_LOG_RETENTION_DAYS:-7}"
REDACT_LOGS="${CTX_GUARD_REDACT_LOGS:-1}"
STATE_DIR="${CTX_GUARD_STATE_DIR:-$DEFAULT_ROOT/state}"
SCRIPT="$1"
AGENT="${2:-${CTX_GUARD_AGENT:-unknown}}"

usable_dir() {
  local dir="$1" probe
  mkdir -p "$dir" 2>/dev/null || return 1
  probe="$(mktemp "$dir/probe-XXXXXXXX" 2>/dev/null)" || return 1
  rm -f "$probe"
}

TMP_ROOT="${TMPDIR:-/tmp}"
FALLBACK_ROOT="${TMP_ROOT%/}/ctx-guard-$(id -u)"

if ! usable_dir "$LOG_DIR"; then
  LOG_DIR="$FALLBACK_ROOT/logs"
  if ! usable_dir "$LOG_DIR"; then
    # Nowhere to archive output: run uncapped rather than failing the command.
    echo "ctx-guard: no writable log dir, running without output capping" >&2
    bash "$SCRIPT"
    STATUS=$?
    rm -f "$SCRIPT"
    exit $STATUS
  fi
fi

usable_dir "$STATE_DIR" || STATE_DIR="$FALLBACK_ROOT/state"

# Stats: CTX_GUARD_STATS_FILE > $CTX_GUARD_STATE_DIR/stats.jsonl > persistent XDG
# default, which falls back to the legacy runtime root when not writable.
if [ -n "${CTX_GUARD_STATS_FILE:-}" ]; then
  STATS_FILE="$CTX_GUARD_STATS_FILE"
elif [ -n "${CTX_GUARD_STATE_DIR:-}" ]; then
  STATS_FILE="$STATE_DIR/stats.jsonl"
else
  PERSIST_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/ctx-guard"
  if usable_dir "$PERSIST_DIR"; then
    chmod 700 "$PERSIST_DIR" 2>/dev/null || true
    STATS_FILE="$PERSIST_DIR/stats.jsonl"
  else
    LEGACY_DIR="${CTX_GUARD_RUNTIME_ROOT:-$DEFAULT_ROOT}/state"
    usable_dir "$LEGACY_DIR" || LEGACY_DIR="$STATE_DIR"
    STATS_FILE="$LEGACY_DIR/stats.jsonl"
  fi
fi

chmod 700 "$LOG_DIR" "$STATE_DIR" 2>/dev/null || true

# Self-prune: archived logs are never rotated elsewhere, so do it here on every run.
find "$LOG_DIR" -maxdepth 1 -name 'run-*' -mtime "+${RETENTION_DAYS}" -delete 2>/dev/null || true

# BSD/macOS mktemp only randomizes trailing Xs -- anything after them (like a
# ".log" suffix) is taken literally, silently reusing the same filename every
# call. Keep the Xs at the very end and match "run-*" for retention instead.
RAW_LOG="$(mktemp "$LOG_DIR/raw-XXXXXXXX")"

START_MS="$(python3 -c 'import time; print(int(time.time() * 1000))' 2>/dev/null || echo "")"
bash "$SCRIPT" >"$RAW_LOG" 2>&1
STATUS=$?
END_MS="$(python3 -c 'import time; print(int(time.time() * 1000))' 2>/dev/null || echo "")"

TOTAL=$(wc -l < "$RAW_LOG")
ORIG_BYTES=$(wc -c < "$RAW_LOG" | tr -d ' ')

redact_file() {
  python3 - "$1" <<'PY'
import re
import sys

path = sys.argv[1]
assignment = re.compile(
    r"""(?ix)
    (\b(?:api[_-]?key|access[_-]?token|auth[_-]?token|client[_-]?secret|
    password|passwd|secret|private[_-]?key)\b["']?\s*[:=]\s*["']?)
    ([^\s,"']+)
    """
)
bearer = re.compile(r"(?i)(\bauthorization\s*:\s*bearer\s+)[^\s]+")
known_token = re.compile(
    r"\b(?:gh[pousr]_[A-Za-z0-9_]+|sk-[A-Za-z0-9-]{20,}|"
    r"xox[baprs]-[A-Za-z0-9-]+|AKIA[0-9A-Z]{16})\b"
)
private_key = re.compile(r"-----BEGIN [^-]*PRIVATE KEY-----")
private_key_end = re.compile(r"-----END [^-]*PRIVATE KEY-----")

in_private_key = False
with open(path, encoding="utf-8", errors="replace") as stream:
    for line in stream:
        if in_private_key:
            if private_key_end.search(line):
                in_private_key = False
            print("[REDACTED PRIVATE KEY]")
            continue
        if private_key.search(line):
            in_private_key = not bool(private_key_end.search(line))
            print("[REDACTED PRIVATE KEY]")
            continue
        line = bearer.sub(r"\1[REDACTED]", line)
        line = assignment.sub(r"\1[REDACTED]", line)
        line = known_token.sub("[REDACTED TOKEN]", line)
        sys.stdout.write(line)
PY
}

# Raw command output never reaches the model by default. Redaction is
# fail-closed: if the sanitizer cannot run, only a withholding notice is
# retained. Set CTX_GUARD_REDACT_LOGS=0 only when local raw logs are
# explicitly acceptable.
LOG="$(mktemp "$LOG_DIR/run-XXXXXXXX")"
if [ "$REDACT_LOGS" = "0" ]; then
  mv "$RAW_LOG" "$LOG"
elif ! redact_file "$RAW_LOG" > "$LOG"; then
  rm -f "$RAW_LOG"
  printf '%s\n' "ctx-guard: output withheld because redaction failed" > "$LOG"
else
  rm -f "$RAW_LOG"
fi
chmod 600 "$LOG"

# log_stats <returned_bytes> <compressed:0|1> -- never lets a stats-logging
# failure affect ctx-guard-run's own exit code. Logs the program name only,
# never arguments or paths.
log_stats() {
  local returned_bytes="$1" compressed="$2"
  python3 - "$STATS_FILE" "$AGENT" "$ORIG_BYTES" "$returned_bytes" "$compressed" "$STATUS" \
    "$SCRIPT" "$START_MS" "$END_MS" <<'PY' 2>/dev/null || true
import json, os, re, shlex, sys, time
stats_file, agent, orig, returned, compressed, status, script, start_ms, end_ms = sys.argv[1:10]

WRAPPERS = {"sudo", "env", "time", "command", "nice"}
ASSIGNMENT = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")
NAME = re.compile(r"^[A-Za-z0-9_.+@-]+$")


def program_name(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#"):
                    break
            else:
                return "(unknown)"
        lex = shlex.shlex(line, posix=True, punctuation_chars=True)
        lex.whitespace_split = True
        lex.commenters = "#"
        tokens = list(lex)
    except (OSError, ValueError):
        return "(unknown)"
    i = 0
    while i < len(tokens):
        tok = tokens[i]
        if ASSIGNMENT.match(tok) or tok in (";", "&&", "||", "&"):
            i += 1
        elif tok == "cd":
            while i < len(tokens) and tokens[i] not in ("&&", ";"):
                i += 1
            i += 1
        elif os.path.basename(tok) in WRAPPERS:
            i += 1
            while i < len(tokens) and tokens[i].startswith("-"):
                i += 2 if os.path.basename(tok) == "nice" and tokens[i] == "-n" else 1
        else:
            name = os.path.basename(tok)
            return name if NAME.match(name) else "(unknown)"
    return "(unknown)"


try:
    duration_ms = max(0, int(end_ms) - int(start_ms))
except ValueError:
    duration_ms = 0

os.makedirs(os.path.dirname(stats_file), mode=0o700, exist_ok=True)
os.chmod(os.path.dirname(stats_file), 0o700)
event = {
    "ts": time.time(),
    "kind": "ctx_guard_run",
    "agent": agent,
    "command": program_name(script),
    "duration_ms": duration_ms,
    "original_bytes": int(orig),
    "returned_bytes": int(returned),
    "compressed": bool(int(compressed)),
    "exit_status": int(status),
}
fd = os.open(stats_file, os.O_CREAT | os.O_WRONLY | os.O_APPEND, 0o600)
os.write(fd, (json.dumps(event, separators=(",", ":")) + "\n").encode("utf-8"))
os.close(fd)
PY
}

if [ "$TOTAL" -le "$MAX_LINES" ]; then
  cat "$LOG"
  log_stats "$ORIG_BYTES" 0
  rm -f "$SCRIPT"
  exit $STATUS
fi

# --- Compressed view: errors first, then head + tail ---
OUT="$(mktemp "$LOG_DIR/out-XXXXXXXX")"
{
  echo "=== ctx-guard: output compressed ($TOTAL lines -> summary, exit=$STATUS) ==="

  ERR_LINES=$(grep -inE '\b(error|fail|failed|failure|fatal|exception|panic|traceback|warning|assert)\b' "$LOG" | head -40)
  if [ -n "$ERR_LINES" ]; then
    echo "--- errors/warnings (line-numbered) ---"
    echo "$ERR_LINES"
  fi

  HEAD_N=$(( MAX_LINES / 4 ))
  TAIL_N=$(( MAX_LINES / 4 ))
  echo "--- first $HEAD_N lines ---"
  head -n "$HEAD_N" "$LOG"
  echo "--- ... $(( TOTAL - HEAD_N - TAIL_N )) lines omitted ... ---"
  echo "--- last $TAIL_N lines ---"
  tail -n "$TAIL_N" "$LOG"
  echo "=== full output saved: $LOG (grep/sed it for specifics instead of re-running) ==="
} > "$OUT"

cat "$OUT"
RETURNED_BYTES=$(wc -c < "$OUT" | tr -d ' ')
log_stats "$RETURNED_BYTES" 1
rm -f "$OUT" "$SCRIPT"
exit $STATUS
